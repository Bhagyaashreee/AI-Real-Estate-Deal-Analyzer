# ==============================================================================
# AI Real Estate Deal Analyzer - Root Environment Configuration Example
# Copy to backend/.env and frontend/.env.local as needed
# ==============================================================================

# Backend (FastAPI)
PROJECT_NAME="AI Real Estate Deal Analyzer"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DEBUG=True
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATABASE_URL="sqlite:///./data/real_estate.db"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:8000"

